{
    "name": "cpms/clinic-practice-management",
    "description": "Clinic Practice Management for WordPress — custom medical tables, booking, queue, EMR, finance, audit.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^7.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "yoast/phpunit-polyfills": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "ClinicCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClinicCore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:unit": "phpunit --configuration phpunit.xml --testsuite Unit"
    },
    "config": {
        "sort-packages": true
    }
}

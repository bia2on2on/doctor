#!/usr/bin/env php
<?php
/**
 * CLI CPMS — System Cron + عملیات فنی (ADR-0016).
 *
 * Production crontab (هر دقیقه):
 *   * * * * * cd /var/www/wp && php bin/cpms jobs tick --limit=20 >> /var/log/cpms-tick.log 2>&1
 *
 *   bin/cpms migrate                       # اجرای Migrationها
 *   bin/cpms jobs tick [--limit=20]        # پردازش Jobها (با GET_LOCK — بدون Duplicate Runner)
 *   bin/cpms jobs list [--status=failed]   # لیست Jobها
 *   bin/cpms jobs retry <id>               # Retry یک Job شکست‌خورده
 *   bin/cpms audit verify [10000]          # صحت‌سنجی زنجیر هش Audit
 *   bin/cpms slots generate [--days=30]    # تولید Slotهای آینده
 *   bin/cpms backup run                    # بکاپ دستی (DB cpms_* + storage)
 *   bin/cpms backup list                   # فهرست بکاپ‌ها
 *   bin/cpms backup verify <id>            # تأیید تمامیت یک بکاپ
 *   bin/cpms backup prune                  # اعمال Retention
 *   bin/cpms backup restore <id> --yes     # بازیابی (Safety Backup خودکار؛ مخرب)
 *   bin/cpms update check [--channel=X]   # بررسی به‌روزرسانی امضاشده (ADR-0029)
 *   bin/cpms health                        # Health (شامل Queue Stale detection)
 *   bin/cpms status                        # وضعیت کلی (شامل وضعیت مجوز)
 */

if (PHP_SAPI !== 'cli') {
    exit(1);
}

$root = dirname(__DIR__);
$abspath = getenv('WP_HOME') ?: dirname($root);
define('ABSPATH', rtrim($abspath, '/') . '/');
if (!is_file(ABSPATH . 'wp-load.php')) {
    fwrite(STDERR, "ABSPATH not found: {$abspath}\n");
    exit(1);
}

require_once ABSPATH . 'wp-load.php';

use ClinicCore\Bootstrap\App;
use ClinicCore\Cli\CliErrorReporter;
use ClinicCore\Domain\Backup\BackupVerificationErrorCodes;
use ClinicCore\Infrastructure\Backup\BackupException;
use ClinicCore\Infrastructure\Storage\StorageConfigurationException;

$cmd = $argv[1] ?? 'status';
$sub = $argv[2] ?? '';
$arg3 = $argv[3] ?? '';
$limit = 20;
$verify = 10_000;
$days = 30;
$status = 'failed';
$jobId = null;
for ($i = 2; $i < count($argv); $i++) {
    if (str_starts_with($argv[$i], '--limit=')) {
        $limit = (int) substr($argv[$i], 8);
    }
    if (str_starts_with($argv[$i], '--days=')) {
        $days = (int) substr($argv[$i], 7);
    }
    if (str_starts_with($argv[$i], '--status=')) {
        $status = substr($argv[$i], 9);
    }
}
if ($sub !== '' && is_numeric($sub) && in_array($cmd, ['audit', 'jobs'], true)) {
    if ($cmd === 'jobs') {
        $jobId = (int) $sub;
    } else {
        $verify = (int) $sub;
    }
}

App::boot();

switch ($cmd) {
    case 'migrate':
        if ( ! App::is_database_engine_supported() ) {
            fwrite( STDERR, "Refusing to run migrations on an unsupported or unreadable database server.\n" );
            exit( 1 );
        }
        $applied = App::migrations()->migrate();
        echo $applied === [] ? 'Schema already up to date.' : 'Applied: ' . implode(', ', $applied) . "\n";
        break;

    case 'jobs':
        if ( in_array( $sub, [ 'tick', 'retry' ], true ) && App::is_runtime_blocked_by_pending_schema() ) {
            fwrite( STDERR, "Runtime blocked: unsupported database server with pending schema migrations.\n" );
            exit( 1 );
        }
        switch ($sub) {
            case 'tick':
                // F1-7 — قفل داخل App::runTick() است (WP-Cron و CLI همان
                // مکانیزم GET_LOCK را دارند؛ قفلِ محلیِ اینجا حذف شد).
                $n = App::runTick($limit);
                if ($n < 0) {
                    echo App::isTickLocked()
                        ? "Another tick is running; skipped.\n"
                        : "Tick skipped (lock unavailable).\n";
                    break;
                }
                echo "Processed {$n} job(s)\n";
                break;

            case 'list':
                $rows = $wpdb->get_results(
                    $wpdb->prepare(
                        'SELECT id, type, status, attempts, max_attempts, last_error, created_at
                         FROM ' . $wpdb->prefix . 'cpms_jobs
                         WHERE status = %s
                         ORDER BY id DESC LIMIT 100', // phpcs:ignore WordPress.DB.PreparedSQL.NotPrepared
                        $status
                    ),
                    ARRAY_A
                );
                if ($rows === []) {
                    echo "No {$status} jobs.\n";
                    break;
                }
                foreach ($rows as $r) {
                    printf(
                        "#%d  %-22s %-10s %d/%d  %s  %s\n",
                        (int) $r['id'],
                        $r['type'],
                        $r['status'],
                        (int) $r['attempts'],
                        (int) $r['max_attempts'],
                        $r['last_error'] ?? '-',
                        $r['created_at']
                    );
                }
                break;

            case 'retry':
                if ($jobId === null) {
                    fwrite(STDERR, "Usage: bin/cpms jobs retry <id>\n");
                    exit(1);
                }
                $updated = $wpdb->query(
                    $wpdb->prepare(
                        'UPDATE ' . $wpdb->prefix . 'cpms_jobs
                         SET status = %s, run_after = %s, last_error = NULL
                         WHERE id = %d AND status = %s', // phpcs:ignore WordPress.DB.PreparedSQL.NotPrepared
                        'queued',
                        gmdate('Y-m-d H:i:s') . '.000',
                        $jobId,
                        'failed'
                    )
                );
                echo $updated ? "Job #{$jobId} re-queued.\n" : "Job #{$jobId} not found or not in failed state.\n";
                break;

            default:
                fwrite(STDERR, "Usage: bin/cpms jobs [tick|list|retry] [args]\n");
                exit(1);
        }
        break;

    case 'audit':
        if ($sub === 'verify') {
            $result = App::audit()->verifyChain($verify);
            if ($result['ok']) {
                echo "Audit chain OK (checked {$result['checked']} rows)\n";
                exit(0);
            }
            fwrite(STDERR, "AUDIT CHAIN BROKEN at row {$result['broken_at']} (checked {$result['checked']})\n");
            exit(2);
        }
        fwrite(STDERR, "Usage: bin/cpms audit verify [limit]\n");
        exit(1);

    case 'slots':
        if ($sub === 'generate') {
            if ( App::is_runtime_blocked_by_pending_schema() ) {
                fwrite( STDERR, "Runtime blocked: unsupported database server with pending schema migrations.\n" );
                exit( 1 );
            }
            // Canonical queue-consumption: all production consumers must go through runTick()
            // which owns GET_LOCK('cpms_jobs_tick'). Direct dispatcher()->tick() without lock
            // created a second global consumer (previous bug). Using runTick preserves
            // synchronous processing (B) but with installation-level serialization.
            App::jobs()->enqueue('slots.generate', ['horizon_days' => $days, 'source' => 'manual'], priority: 9);
            $n = App::runTick(10);
            if ($n < 0) {
                echo "Enqueued slots.generate; tick skipped (another worker running)\n";
            } else {
                echo "Enqueued slots.generate; processed {$n} job(s)\n";
            }
        } else {
            fwrite(STDERR, "Usage: bin/cpms slots generate [--days=N]\n");
            exit(1);
        }
        break;

    case 'update':
        // bin/cpms update check [--channel=stable|beta]
        // نصب واقعی توسط installer استاندارد وردپرس انجام می‌شود (صفحهٔ
        // به‌روزرسانی یا `wp plugin update clinic-practice-management` —
        // صحت sha256 در upgrader_pre_download تضمین شده؛ ADR-0029).
        $channel = 'stable';
        foreach ($argv as $a) {
            if (str_starts_with($a, '--channel=')) {
                $c = substr($a, 10);
                $channel = ($c === 'beta' || $c === 'stable') ? $c : 'stable';
            }
        }
        if ($sub !== 'check') {
            fwrite(STDERR, "Usage: bin/cpms update check [--channel=stable|beta]\n");
            exit(1);
        }
        $r = App::updateService()->checkForUpdates(true, $channel);
        if (($r['available'] ?? false) === true) {
            echo "Update available [{$channel}]\n";
            echo '  version:       ' . $r['version'] . "\n";
            echo '  package_sha256: ' . $r['package_sha256'] . "\n";
            echo '  package_url:   ' . $r['package_url'] . "\n";
            echo "  install:       صفحهٔ به‌روزرسانی وردپرس یا `wp plugin update clinic-practice-management` (یکپارچگی خودکار)\n";
            exit(0);
        }
        echo 'No update available [' . $channel . '] (' . ($r['reason'] ?? '') . ")\n";
        break;

    case 'health':
        $q = App::queueHealth();
        echo "Queue health\n";
        echo '  last_tick: ' . ($q['last_tick_at'] ? gmdate('c', (int) $q['last_tick_at']) : 'never') . "\n";
        echo '  stale:     ' . ($q['stale'] ? 'YES — بررسی Cron/Queue!' : 'no') . "\n";
        echo '  queued:    ' . $q['queued'] . "\n";
        echo '  failed:    ' . $q['failed'] . "\n";
        exit($q['stale'] ? 3 : 0);

    case 'backup':
        try {
            $backups = App::backupService();
            switch ($sub) {
                case 'run':
                    $meta = $backups->createBackup('manual-cli');
                    echo "Backup created: {$meta['backup_id']}\n";
                    break;
                case 'list':
                    foreach ($backups->listBackups() as $b) {
                        printf(
                            "%-52s %-25s tables=%-3d rows=%-8d files=%-4d integrity=%s\n",
                            $b['backup_id'],
                            $b['created_at'],
                            (int) $b['tables'],
                            (int) $b['rows'],
                            (int) $b['storage_files'],
                            $b['integrity']
                        );
                    }
                    break;
                case 'verify':
                    if ($arg3 === '') {
                        fwrite(STDERR, "Usage: bin/cpms backup verify <backup_id>\n");
                        exit(1);
                    }
                    try {
                        $v = $backups->verifyBackup($arg3);
                    } catch (\Throwable) {
                        exit(CliErrorReporter::report_backup_verification_failure([
                            BackupVerificationErrorCodes::VERIFICATION_FAILED,
                        ]));
                    }
                    if (empty($v['ok'])) {
                        exit(CliErrorReporter::report_backup_verification_failure((array) ($v['errors'] ?? [])));
                    }
                    $warnings = BackupVerificationErrorCodes::safe_warning_categories((array) ($v['warnings'] ?? []));
                    echo "OK — backup verified";
                    if ($warnings !== []) {
                        echo ' (warnings: ' . implode(', ', $warnings) . ')';
                    }
                    echo "\n";
                    exit(0);
                case 'prune':
                    $removed = $backups->prune();
                    echo $removed === [] ? "Nothing to prune.\n" : 'Removed: ' . implode(', ', $removed) . "\n";
                    break;
                case 'restore':
                    // bin/cpms backup restore <backup_id> --yes  (تأیید صریح)
                    $yes = in_array('--yes', $argv, true);
                    if ($arg3 === '' || !$yes) {
                        fwrite(STDERR, "Usage: bin/cpms backup restore <backup_id> --yes  (همراه با تأیید صریح؛ Safety Backup خودکار)\n");
                        exit(1);
                    }
                    $pre = $backups->restoreApply($arg3, true);
                    echo "Restore applied (backup {$arg3}). Safety backup created first. preflight:\n";
                    echo '  integrity_ok=' . ($pre['integrity_ok'] ? 'yes' : 'no') . ' tables=' . (int) $pre['tables'] . " rows=" . (int) $pre['rows'] . "\n";
                    break;
                default:
                    fwrite(STDERR, "Usage: bin/cpms backup [run|list|verify <id>|prune|restore <id> --yes]\n");
                    exit(1);
            }
        } catch ( BackupException | StorageConfigurationException $error ) {
            exit( CliErrorReporter::report_backup_failure( $error ) );
        } catch ( \Throwable ) {
            exit( CliErrorReporter::report_unexpected_backup_failure() );
        }
        break;

    case 'status':
    default:
        $tables = App::db()->count_cpms_tables();
        $q = App::queueHealth();
        echo "CPMS status\n";
        echo '  version: ' . (defined('CPMS_VERSION') ? CPMS_VERSION : 'dev') . "\n";
        echo '  schema:  ' . (App::migrations()->currentVersion() ?? 'none') . "\n";
        echo '  tables:  ' . (int) $tables . "\n";
        echo '  queue:   last_tick=' . ($q['last_tick_at'] ?: 'never') . ' failed=' . $q['failed'] . ' stale=' . ($q['stale'] ? 'YES' : 'no') . "\n";
        $lic = App::licenseService()->currentState();
        echo '  license: ' . $lic['status'] . ($lic['reason'] !== '' ? " ({$lic['reason']})" : '') . "\n";
        break;
}
